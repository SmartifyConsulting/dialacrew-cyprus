{
  "mailer_subjects_confirmation": "Confirm your Book a Crew account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your Book a Crew account</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Welcome to Book a Crew</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Welcome to Book a Crew</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">Confirm your email address to finish setting up your account.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not create an account, you can ignore this email.</p>\n\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0\"><tr><td bgcolor=\"#1550d5\" style=\"border-radius:6px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700\">Confirm email address</a></td></tr></table><p style=\"font-size:12px;line-height:1.6;color:#64748b;overflow-wrap:anywhere\">If the button does not work, open this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1550d5;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_invite": "Your invitation to Book a Crew",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your invitation to Book a Crew</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">You’re invited</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">You’re invited</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">You have been invited to join Book a Crew. Accept your invitation to set up your account and connect with your production team.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you were not expecting this invitation, you can ignore this email.</p>\n\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0\"><tr><td bgcolor=\"#1550d5\" style=\"border-radius:6px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700\">Accept invitation</a></td></tr></table><p style=\"font-size:12px;line-height:1.6;color:#64748b;overflow-wrap:anywhere\">If the button does not work, open this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1550d5;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_recovery": "Reset your Book a Crew password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Reset your Book a Crew password</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Reset your password</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Reset your password</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">We received a request to reset your Book a Crew password. Use the button below to choose a new password.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not request this, you can ignore this email. Your password will stay the same.</p>\n\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0\"><tr><td bgcolor=\"#1550d5\" style=\"border-radius:6px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700\">Reset password</a></td></tr></table><p style=\"font-size:12px;line-height:1.6;color:#64748b;overflow-wrap:anywhere\">If the button does not work, open this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1550d5;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_magic_link": "Your Book a Crew sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Book a Crew sign-in link</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Sign in to Book a Crew</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Sign in to Book a Crew</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">Use this secure link to sign in to your account.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not request this link, you can ignore this email.</p>\n\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0\"><tr><td bgcolor=\"#1550d5\" style=\"border-radius:6px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700\">Sign in</a></td></tr></table><p style=\"font-size:12px;line-height:1.6;color:#64748b;overflow-wrap:anywhere\">If the button does not work, open this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1550d5;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_email_change": "Confirm your Book a Crew email change",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your Book a Crew email change</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Confirm your email address</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Confirm your email address</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">Confirm this email address to complete the requested change to your Book a Crew account.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not request this change, open Book a Crew directly and review your account security.</p>\n\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0\"><tr><td bgcolor=\"#1550d5\" style=\"border-radius:6px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700\">Confirm email change</a></td></tr></table><p style=\"font-size:12px;line-height:1.6;color:#64748b;overflow-wrap:anywhere\">If the button does not work, open this link:<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#1550d5;word-break:break-all\">{{ .ConfirmationURL }}</a></p>\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_reauthentication": "Your Book a Crew verification code",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Book a Crew verification code</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Verify it’s you</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Verify it’s you</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">Enter this verification code in Book a Crew to continue.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">Never share this code. If you did not request it, review your account security.</p>\n<p style=\"padding:16px;background:#f4f6f8;border-radius:6px;font-size:28px;font-weight:700;letter-spacing:6px;text-align:center\">{{ .Token }}</p>\n\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_password_changed_notification": "Your Book a Crew password changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Book a Crew password changed</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Your password was changed</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Your password was changed</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">The password for your Book a Crew account was changed.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not make this change, open Book a Crew directly and reset your password immediately.</p>\n\n\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_email_changed_notification": "Your Book a Crew email address changed",
  "mailer_templates_email_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Book a Crew email address changed</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Your email address was changed</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Your email address was changed</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">The email address for your Book a Crew account was changed.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not make this change, open Book a Crew directly and review your account security immediately.</p>\n\n\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_phone_changed_notification": "Your Book a Crew phone number changed",
  "mailer_templates_phone_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Book a Crew phone number changed</title></head>\n<body style=\"margin:0;padding:0;background:#f4f6f8;color:#111827;font-family:Manrope,Arial,sans-serif\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Your phone number was changed</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f6f8\"><tr><td align=\"center\" style=\"padding:24px 12px\">\n<table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e2e5e9;border-radius:12px;overflow:hidden\">\n<tr><td style=\"background:#050505;border-bottom:4px solid #009eff;padding:24px 28px\"><a href=\"https://bookacrew.film\" style=\"color:#ffffff;text-decoration:none;font-size:28px;font-weight:800\">Book <span style=\"color:#009eff\">a</span> Crew</a></td></tr>\n<tr><td style=\"padding:32px 28px\"><h1 style=\"margin:0 0 20px;font-family:Sora,Arial,sans-serif;font-size:24px;line-height:1.35;color:#111827\">Your phone number was changed</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">The phone number for your Book a Crew account was changed.</p>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.65\">If you did not make this change, review your account security immediately.</p>\n\n\n</td></tr><tr><td style=\"padding:20px 28px;border-top:1px solid #e2e5e9;background:#fafbfc;font-size:12px;line-height:1.6;color:#64748b\">This is an automated message from Book a Crew. Please do not reply to this address.<br><a href=\"https://bookacrew.film\" style=\"color:#1550d5;text-decoration:none\">bookacrew.film</a></td></tr></table>\n</td></tr></table></body></html>",
  "mailer_subjects_mfa_factor_enrolled_notification": "Book a Crew verification method added",
